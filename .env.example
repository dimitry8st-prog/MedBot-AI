# MedBot AI — Environment Variables
# Скопируйте этот файл в .env и заполните реальными значениями

# API Keys
GIGACHAT_API_KEY=your_gigachat_api_key_here
CLAUDE_API_KEY=your_claude_api_key_here  # Опционально, для fallback
TG_BOT_TOKEN=your_telegram_bot_token_here

# Database
DATABASE_URL=postgresql://medbot_user:secure_password@localhost:5432/medbot_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=  # Пустое для локального dev, задайте для production

# ChromaDB
CHROMADB_PATH=./data/chromadb
CHROMADB_HOST=localhost  # Для docker: chromadb
CHROMADB_PORT=8000

# JWT
JWT_SECRET_KEY=your_super_secret_jwt_key_min_256_bits_change_this_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Security
BCRYPT_ROUNDS=12
CORS_ORIGINS=http://localhost:3000,https://medbot.ai  # Разделенные запятой

# Rate Limiting
RATE_LIMIT_USER=60  # Запросов в минуту для обычных пользователей
RATE_LIMIT_ADMIN=300  # Запросов в минуту для администраторов
RATE_LIMIT_ANONYMOUS=10  # Запросов в минуту для неавторизованных

# Embeddings
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DEVICE=cpu  # cpu или cuda (если есть GPU)
EMBEDDING_BATCH_SIZE=32

# LLM
LLM_PRIMARY=gigachat  # gigachat или claude
LLM_FALLBACK_ENABLED=true
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.3

# RAG
RAG_CHUNK_SIZE=800  # Токенов на чанк
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=10  # Количество чанков для retrieval
RAG_RERANK_TOP_K=3  # Финальное количество после reranking
RAG_SIMILARITY_THRESHOLD=0.7

# File Upload
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=pdf,docx,html
UPLOAD_DIR=./data/uploads

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=./logs/medbot.log
LOG_FORMAT=json  # json или text

# Application
APP_NAME=MedBot AI
APP_VERSION=1.0.0
APP_ENV=development  # development, staging, production
DEBUG=true  # false для production

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4  # Количество uvicorn workers (для production)

# Frontend
VITE_API_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws  # Для будущего WebSocket

# Telegram Bot
TG_BOT_API_URL=http://localhost:8000/api/v1
TG_BOT_WEBHOOK_ENABLED=false  # true для production
TG_BOT_WEBHOOK_URL=https://medbot.ai/webhook/telegram

# Analytics
ANALYTICS_AGGREGATION_CRON=0 2 * * *  # Каждый день в 2:00
ANALYTICS_RETENTION_DAYS=365

# Cache
CACHE_TTL_SECONDS=3600  # 1 час
CACHE_ENABLED=true

# Monitoring (опционально)
SENTRY_DSN=  # Sentry для error tracking
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090
